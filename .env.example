# Legacy one-time import only. On first launch these values are moved into the
# system credential manager and cleared from .env. Prefer configuring keys in UI.
LLM_API_KEY=
DEEPSEEK_API_KEY=

# Legacy one-time import for web search (prefer Model Settings > Capability Center):
BRAVE_SEARCH_API_KEY=

# Optional overrides:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
# LLM_EMBEDDING_MODE=disabled
# LLM_EMBEDDING_MODEL=
# For a separate or local embedding service:
# LLM_EMBEDDING_BASE_URL=http://localhost:11434/v1
# LLM_EMBEDDING_API_KEY=
# LLM_PROVIDER_TYPE=auto
# LLM_COST_TRACKING_MODE=auto
# Price-entry currency, primary display currency, and USD-to-CNY display factor:
# LLM_PRICING_CURRENCY=USD
# LLM_DISPLAY_CURRENCY=CNY
# LLM_USD_TO_CNY_RATE=7.142857
# Optional pricing for local task estimates and usage accounting (per 1M tokens,
# in LLM_PRICING_CURRENCY):
# LLM_INPUT_PRICE_PER_MILLION=0
# LLM_CACHED_INPUT_PRICE_PER_MILLION=0
# LLM_CACHE_WRITE_PRICE_PER_MILLION=0
# LLM_OUTPUT_PRICE_PER_MILLION=0
# LLM_EMBEDDING_PRICE_PER_MILLION=0
